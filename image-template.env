# Build parameters for Firox Linux (read by the Justfile)

# Output image name. Keep in sync with the GitHub repo name.
IMAGE_NAME=firefoxos

# GitHub user/organisation that owns the repo
REPO_ORGANIZATION="kurodenkou"

IMAGE_DESC="Firox Linux: a Universal Blue image built around Firefox web apps and Waydroid, with a classic XP-style Wayland desktop"
IMAGE_KEYWORDS="bootc,oci,linux,universal-blue,firefox,pwa,waydroid,labwc"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
