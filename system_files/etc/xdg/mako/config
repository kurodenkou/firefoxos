# XP-style "balloon tip" notifications, bottom-right above the taskbar
font=Tahoma, DejaVu Sans 10
background-color=#ffffe1
text-color=#000000
border-color=#000000
border-size=1
border-radius=8
padding=10
margin=8
width=340
icons=1
max-icon-size=32
icon-path=/usr/share/icons/Papirus
anchor=bottom-right
default-timeout=8000
layer=overlay

[urgency=critical]
border-color=#c4381a
default-timeout=0
