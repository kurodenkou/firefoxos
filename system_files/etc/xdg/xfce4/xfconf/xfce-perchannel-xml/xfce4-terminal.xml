<?xml version="1.0" encoding="UTF-8"?>
<!--
  Firox Linux defaults for the Command Prompt (xfce4-terminal). Change them in
  the terminal's Edit > Preferences; your changes are saved in
  ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml.
  Colours: light grey on near-black, like Windows Terminal's "Campbell".
-->
<channel name="xfce4-terminal" version="1.0">
  <property name="misc-default-geometry" type="string" value="100x30"/>
  <property name="scrolling-lines" type="uint" value="10000"/>
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="Monospace 11"/>
  <property name="misc-cursor-blinks" type="bool" value="true"/>
  <property name="misc-confirm-close" type="bool" value="true"/>
  <property name="misc-menubar-default" type="bool" value="true"/>
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#cccccc"/>
  <property name="color-background" type="string" value="#0c0c0c"/>
  <property name="color-cursor" type="string" value="#ffffff"/>
  <property name="color-cursor-use-default" type="bool" value="false"/>
  <property name="color-bold-use-default" type="bool" value="true"/>
  <property name="color-palette" type="string" value="#0c0c0c;#c50f1f;#13a10e;#c19c00;#0037da;#881798;#3a96dd;#cccccc;#767676;#e74856;#16c60c;#f9f1a5;#3b78ff;#b4009e;#61d6d6;#f2f2f2"/>
</channel>
