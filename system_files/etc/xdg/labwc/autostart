# Firox Linux session autostart (run by labwc at login).
# Per-user overrides: ~/.config/labwc/autostart replaces this file.

# Classic or Modern look: see `firox-theme` and Control Panel > Appearance
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

# Desktop: wallpaper + My Computer / Recycle Bin icons
# (~/Desktop etc. must exist before pcmanfm-qt starts)
xdg-user-dirs-update
pcmanfm-qt --desktop --profile=firox >/dev/null 2>&1 &

# Taskbar (a ~/.config/waybar/style.css of your own wins over the theme)
if [ -e "$CFG/waybar/style.css" ]; then
    waybar >/dev/null 2>&1 &
else
    waybar -s "$(firox-theme path waybar.css)" >/dev/null 2>&1 &
fi

# Notifications ("balloon tips")
if [ -f "$CFG/mako/config" ]; then
    mako >/dev/null 2>&1 &
else
    mako -c "$(firox-theme path mako.conf)" >/dev/null 2>&1 &
fi

# Notification-area (tray) icons
( sleep 2; nm-applet --indicator ) >/dev/null 2>&1 &
( sleep 2; blueman-applet ) >/dev/null 2>&1 &

# Password prompts for admin tasks
/usr/libexec/polkit-mate-authentication-agent-1 >/dev/null 2>&1 &

# Monitor layout saved from Control Panel > Display: kanshi applies it (and
# re-applies on hotplug); firox-displays then double-checks and fixes
# anything kanshi couldn't, logging to ~/.local/state/firox/displays.log
kanshi >/dev/null 2>&1 &
( sleep 3; firox-displays restore ) >/dev/null 2>&1 &

# Screen saver: lock after 10 minutes, blank after 15
swayidle -w \
    timeout 600 'firox-open lock' \
    timeout 900 'wlopm --off \*' \
    resume 'wlopm --on \*' \
    before-sleep 'firox-open lock' >/dev/null 2>&1 &

# One-time per-user setup (folders, web app runtime, welcome tip)
firox-user-setup >/dev/null 2>&1 &
