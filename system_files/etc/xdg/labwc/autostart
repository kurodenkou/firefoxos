# Firox Linux session autostart (run by labwc at login).
# Per-user overrides: ~/.config/labwc/autostart replaces this file.

# Classic or Modern look: see `firox-theme` and Settings > Appearance
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

# Desktop: wallpaper + Computer / Recycle Bin icons
# (~/Desktop etc. must exist before pcmanfm-qt starts)
xdg-user-dirs-update
pcmanfm-qt --desktop --profile=firox >/dev/null 2>&1 &

# Taskbar (a ~/.config/waybar/style.css of your own wins over the theme)
if [ -e "$CFG/waybar/style.css" ]; then
    waybar >/dev/null 2>&1 &
else
    waybar -s "$(firox-theme path waybar.css)" >/dev/null 2>&1 &
fi

# Notification history for the bell in the notification area (start it
# before anything sends a notification)
firox-notifications daemon >/dev/null 2>&1 &

# Notifications ("balloon tips")
if [ -f "$CFG/mako/config" ]; then
    mako >/dev/null 2>&1 &
else
    mako -c "$(firox-theme path mako.conf)" >/dev/null 2>&1 &
fi

# Notification-area (tray) icons
( sleep 2; nm-applet --indicator ) >/dev/null 2>&1 &
( sleep 2; blueman-applet ) >/dev/null 2>&1 &

# Password prompts for admin tasks
/usr/libexec/polkit-mate-authentication-agent-1 >/dev/null 2>&1 &

# Monitor layout saved from Settings > Display: kanshi applies it (and
# re-applies on hotplug); firox-displays then double-checks and fixes
# anything kanshi couldn't, logging to ~/.local/state/firox/displays.log
kanshi >/dev/null 2>&1 &
( sleep 3; firox-displays restore ) >/dev/null 2>&1 &

# Clipboard: keep what you copied after the app closes, and remember
# recent items for Super+V (Settings > Clipboard, see `firox-clipboard`)
firox-clipboard start

# Power saving: lock, screen off and sleep timers from Settings >
# Power Options (~/.config/firox/power.conf, see `firox-power`)
firox-power start
# Low-battery warnings (laptops only; exits straight away without a battery)
firox-power battery-watch >/dev/null 2>&1 &

# "Firox Linux was updated" once after an update was applied
( sleep 20; firox-updates login ) >/dev/null 2>&1 &

# One-time per-user setup (folders, web app runtime, welcome tip)
firox-user-setup >/dev/null 2>&1 &
