// Firox Linux taskbar. Copy to ~/.config/waybar/ to customise.
{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 0,
    "exclusive": true,
    "modules-left": [
        "custom/start",
        "image#ql-desktop",
        "image#ql-firefox",
        "image#ql-files",
        "custom/ql-sep",
        "wlr/taskbar"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "idle_inhibitor",
        "pulseaudio",
        "battery",
        "custom/updates",
        "custom/notifications",
        "clock"
    ],

    "custom/start": {
        "format": "firox",
        "tooltip": true,
        "tooltip-format": "Click here to begin.",
        "on-click": "firox-startmenu"
    },

    // Quick Launch
    "image#ql-desktop": {
        "path": "/usr/share/icons/Papirus/24x24/apps/show-desktop.svg",
        "size": 18,
        "tooltip": false,
        "on-click": "firox-open show-desktop"
    },
    "image#ql-firefox": {
        "path": "/usr/share/icons/Papirus/24x24/apps/firefox.svg",
        "size": 18,
        "tooltip": false,
        "on-click": "firefox"
    },
    "image#ql-files": {
        "path": "/usr/share/icons/Papirus/24x24/apps/system-file-manager.svg",
        "size": 18,
        "tooltip": false,
        "on-click": "firox-open computer"
    },
    "custom/ql-sep": {
        "format": " ",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon} {title:.24}",
        "icon-size": 16,
        "icon-theme": "Papirus",
        "tooltip-format": "{title}",
        "on-click": "minimize-raise",
        "on-click-middle": "close",
        "on-click-right": "close",
        "all-outputs": false
    },

    // Shown only when an update is downloaded and needs a restart
    "custom/updates": {
        "exec": "firox-updates status",
        "return-type": "json",
        "interval": 900,
        "signal": 10,
        "on-click": "firox-updates restart",
        "on-click-right": "firox-updates whatsnew",
        "tooltip": true
    },
    // Notification history + Do Not Disturb (firox-notifications)
    "custom/notifications": {
        "exec": "firox-notifications status",
        "return-type": "json",
        "signal": 9,
        "interval": 60,
        "on-click": "firox-notifications toggle",
        "on-click-right": "firox-notifications dnd toggle",
        "tooltip": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Screen saver disabled",
        "tooltip-format-deactivated": "Screen saver enabled"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "Volume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "battery": {
        "format": "{icon}",
        "format-charging": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% remaining ({timeTo})",
        "states": { "warning": 20, "critical": 10 }
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%A, %B %d, %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "firox-control-panel datetime"
    }
}
