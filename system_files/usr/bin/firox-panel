#!/usr/bin/python3
"""
firox-panel: the Firox Linux taskbar.

    firox-panel             run the taskbar (started at login)

One bar along the bottom of every monitor:

    start button | Quick Launch | window buttons | notification area | clock

Window buttons are grouped: when an app has two or more windows open they
share one button ("3  Firefox ▴"); click it to pick a window. Right-click a
button for Restore / Minimize / Maximize / Close, or Minimize/Close group.
Right-click an empty part of the taskbar to turn grouping off.

The notification area holds app icons (StatusNotifierItem, e.g. network and
Bluetooth), keep the screen on, volume, battery, a waiting update, the
notification bell and the clock.

Styled by the theme's panel.css (/usr/share/firox/themes/NAME/panel.css),
reloaded when the theme changes; add your own rules in
~/.config/firox/panel.css. Settings: ~/.config/firox/panel.conf (GROUP=1|0).

Exits with status 3 if it can't run here (no layer-shell or window list
support, or a missing library); the session then starts waybar instead.
"""

import glob
import json
import os
import re
import struct
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/firox/python")

CANT_RUN = 3


def cant_run(why):
    print(f"firox-panel: {why}", file=sys.stderr)
    sys.exit(CANT_RUN)


try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402
    from pywayland.client import Display  # noqa: E402
    from pywayland.protocol.wayland import WlOutput, WlSeat  # noqa: E402
    from pywayland.protocol.xdg_output_unstable_v1 import ZxdgOutputManagerV1  # noqa: E402
    from firox_wlr_toplevel import ZwlrForeignToplevelManagerV1  # noqa: E402
except (ImportError, ValueError) as err:
    cant_run(f"missing library: {err}")

THEMES = "/usr/share/firox/themes"
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "firox")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "firox")
SETTINGS = os.path.join(CONFIG, "panel.conf")
AWAKE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "firox-stay-awake")
HEIGHT = 30
