#!/usr/bin/python3
"""
FirefoxOS Start menu.

A two-column start menu in the style of the classic XP layout, drawn as a
wlr-layer-shell overlay so it sits above every window:

    +------------------------------------------+
    | [avatar]  User Name                      |  <- blue header
    +---------------------+--------------------+
    | Internet  (pinned)  | My Documents       |
    | Android Apps        | My Pictures        |
    |---------------------| My Music           |
    | most-used apps...   | My Computer        |
    |                     |--------------------|
    |                     | Control Panel      |
    |---------------------| Web Apps ...       |
    |   All Programs  >   | Help / Search / Run|
    +---------------------+--------------------+
    |               [Log Off] [Turn Off Computer]  <- blue footer
    +------------------------------------------+

The process stays resident after the first launch (`--daemon` preloads it at
login) so the menu opens instantly; running `firefoxos-startmenu` again
toggles it. Typing while the menu is open searches All Programs.

    firefoxos-startmenu                 toggle the menu
    firefoxos-startmenu --all-programs  open straight to All Programs
    firefoxos-startmenu --power         "Turn off computer" dialog
    firefoxos-startmenu --log-off       "Log Off" dialog
    firefoxos-startmenu --daemon        preload without showing
    firefoxos-startmenu --hide | --quit
"""

import json
import os
import pwd
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

try:  # GLib >= 2.86 moved DesktopAppInfo to GioUnix
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix  # noqa: E402

    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ImportError, ValueError):
    DesktopAppInfo = Gio.DesktopAppInfo

APP_ID = "org.firefoxos.StartMenu"
PANEL_HEIGHT = 30
STATE_DIR = os.path.join(GLib.get_user_state_dir(), "firefoxos")
STATE_FILE = os.path.join(STATE_DIR, "startmenu.json")
MFU_COUNT = 6

# Apps shown in the "most frequently used" list until the user has history.
DEFAULT_MFU = [
    "pcmanfm-qt.desktop",
    "org.xfce.mousepad.desktop",
    "galculator.desktop",
    "foot.desktop",
    "org.xfce.ristretto.desktop",
    "org.pulseaudio.pavucontrol.desktop",
]

# Friendlier names for the stock apps in the menu's left column
FRIENDLY_NAMES = {
    "pcmanfm-qt.desktop": "File Manager",
    "org.xfce.mousepad.desktop": "Text Editor",
    "galculator.desktop": "Calculator",
    "foot.desktop": "Command Prompt",
    "org.xfce.ristretto.desktop": "Picture Viewer",
    "org.pulseaudio.pavucontrol.desktop": "Volume Control",
}

PINNED = [
    # (desktop ids to try in order, title, subtitle)
    (("org.mozilla.firefox.desktop", "firefox.desktop"), "Internet", "Mozilla Firefox"),
    (("firefoxos-webapps.desktop",), "Web Apps", "Install and open web apps"),
    (("firefoxos-android.desktop",), "Android Apps", "Waydroid"),
]

# Desktop entries we never list (helpers, duplicates, ourselves).
HIDDEN = {
    "foot-server.desktop",
    "footclient.desktop",
    "firefoxos-startmenu.desktop",
    "pcmanfm-qt-desktop-pref.desktop",
    "org.xfce.mousepad-settings.desktop",
}

# Freedesktop main categories -> XP-ish folder names, in display order.
CATEGORIES = [
    ("Utility", "Accessories", "applications-accessories"),
    ("Office", "Office", "applications-office"),
    ("Graphics", "Graphics", "applications-graphics"),
    ("AudioVideo", "Entertainment", "applications-multimedia"),
    ("Game", "Games", "applications-games"),
    ("Network", "Internet", "applications-internet"),
    ("Development", "Development", "applications-development"),
    ("Settings", "Settings", "preferences-system"),
    ("System", "System Tools", "applications-system"),
]

