#!/usr/bin/python3
"""
firox-volume: the volume popup (click the speaker on the taskbar).

    firox-volume [toggle|show|hide]

A vertical volume slider with Mute, a list of speakers/headphones to play
through, and a link to the full mixer (pavucontrol). Closes on Esc or a click
anywhere else. Styled by the theme's volume.css.
"""

import json
import os
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402
except (ValueError, ImportError):
    GtkLayerShell = None

THEMES = "/usr/share/firox/themes"
SINK = "@DEFAULT_AUDIO_SINK@"


def run(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def get_volume():
    """(percent, muted) of the default output, or None without one."""
    out = run(["wpctl", "get-volume", SINK])
    m = re.search(r"Volume:\s*([\d.]+)", out)
    if not m:
        return None
    return round(float(m.group(1)) * 100), "MUTED" in out


def sinks():
    """[(name, description)] of the outputs, and the default's name."""
    try:
        data = json.loads(run(["pactl", "-f", "json", "list", "sinks"]) or "[]")
    except ValueError:
        data = []
    out = [(s.get("name", ""), s.get("description") or s.get("name", "")) for s in data if s.get("name")]
    return out, run(["pactl", "get-default-sink"]).strip()


def theme_css():
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    name = "classic"
    for path in (os.path.join(cfg, "firox", "theme"), "/etc/firox/theme"):
        try:
            with open(path) as fh:
                name = fh.read().strip() or name
            break
        except OSError:
            continue
    path = os.path.join(THEMES, name, "volume.css")
    return path if os.path.exists(path) else os.path.join(THEMES, "classic", "volume.css")


def icon_for(pct, muted):
    # Symbolic icons take the text colour, so they suit both looks
    if muted or pct == 0:
        return "audio-volume-muted-symbolic"
    level = "low" if pct < 34 else "medium" if pct < 67 else "high"
    return f"audio-volume-{level}-symbolic"


class Popup(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="Volume")
        self.set_decorated(False)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(screen, self.provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        if GtkLayerShell and GtkLayerShell.is_supported():
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "firox-volume")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
            for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                         GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
                GtkLayerShell.set_anchor(self, edge, True)
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)

        catcher = Gtk.EventBox()
        catcher.set_visible_window(False)
        catcher.connect("button-press-event", lambda *_: self.hide() or True)
        self.add(catcher)
        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", lambda *_: self.hide() or True)

        swallow = Gtk.EventBox()
        swallow.set_visible_window(False)
        swallow.connect("button-press-event", lambda *_: True)
        swallow.set_halign(Gtk.Align.END)
        swallow.set_valign(Gtk.Align.END)
        catcher.add(swallow)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.set_name("panel")
        swallow.add(box)

        head = Gtk.Box(spacing=8)
        head.set_name("panel-header")
        title = Gtk.Label(label="Volume", xalign=0)
        title.get_style_context().add_class("title")
        head.pack_start(title, True, True, 0)
        box.pack_start(head, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        body.set_name("body")
        self.device = Gtk.ComboBoxText()
        self.device.set_tooltip_text("Play sound through")
        self.device_handler = self.device.connect("changed", self.on_device)
        body.pack_start(self.device, False, False, 0)

        row = Gtk.Box(spacing=14)
        row.set_halign(Gtk.Align.CENTER)
        self.icon = Gtk.Image()
        self.icon.set_pixel_size(32)
        self.icon.set_valign(Gtk.Align.START)
        row.pack_start(self.icon, False, False, 0)
        self.scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL,
                               adjustment=Gtk.Adjustment(value=0, lower=0, upper=100,
                                                         step_increment=2, page_increment=10))
        self.scale.set_inverted(True)
        self.scale.set_draw_value(False)
        self.scale.set_size_request(-1, 150)
        self.scale_handler = self.scale.connect("value-changed", self.on_scale)
        row.pack_start(self.scale, False, False, 0)
        self.pct = Gtk.Label()
        self.pct.set_name("percent")
        self.pct.set_valign(Gtk.Align.START)
        self.pct.set_width_chars(4)
        row.pack_start(self.pct, False, False, 0)
        body.pack_start(row, False, False, 0)

        self.mute = Gtk.CheckButton(label="Mute")
        self.mute.set_halign(Gtk.Align.CENTER)
        self.mute_handler = self.mute.connect("toggled", self.on_mute)
        body.pack_start(self.mute, False, False, 0)
        self.none = Gtk.Label(label="No sound device was found.")
        body.pack_start(self.none, False, False, 0)
        box.pack_start(body, False, False, 0)

        foot = Gtk.Box()
        foot.set_name("panel-footer")
        mixer = Gtk.Button(label="Mixer…")
        mixer.get_style_context().add_class("link")
        mixer.set_tooltip_text("Volume for each app, microphones and more")
        mixer.connect("clicked", self.on_mixer)
        foot.pack_start(mixer, False, False, 0)
        box.pack_start(foot, False, False, 0)

        self.timer = None

    # ----------------------------------------------------------- refresh --

    def refresh(self):
        """Follow changes made elsewhere (keys, mixer) while open."""
        vol = get_volume()
        have = vol is not None
        for w in (self.scale, self.mute, self.icon, self.pct):
            w.set_visible(have)
        self.none.set_visible(not have)
        if have:
            pct, muted = vol
            with self.scale.handler_block(self.scale_handler):
                if abs(self.scale.get_value() - pct) >= 1:
                    self.scale.set_value(min(pct, 100))
            with self.mute.handler_block(self.mute_handler):
                self.mute.set_active(muted)
            self.show_level(pct, muted)
        return True

    def show_level(self, pct, muted):
        self.icon.set_from_icon_name(icon_for(pct, muted), Gtk.IconSize.DIALOG)
        self.icon.set_pixel_size(32)
        self.pct.set_text("Muted" if muted else f"{pct}%")

    def fill_devices(self):
        outs, default = sinks()
        with self.device.handler_block(self.device_handler):
            self.device.remove_all()
            for name, desc in outs:
                self.device.append(name, desc)
            if default:
                self.device.set_active_id(default)
        self.device.set_visible(len(outs) > 1)

    # ----------------------------------------------------------- actions --

    def on_scale(self, scale):
        pct = int(scale.get_value())
        subprocess.Popen(["wpctl", "set-volume", "-l", "1.0", SINK, f"{pct / 100:.2f}"])
        if self.mute.get_active() and pct > 0:
            self.mute.set_active(False)   # moving the slider unmutes, like the keys
        self.show_level(pct, self.mute.get_active())

    def on_mute(self, button):
        subprocess.Popen(["wpctl", "set-mute", SINK, "1" if button.get_active() else "0"])
        self.show_level(int(self.scale.get_value()), button.get_active())

    def on_device(self, combo):
        name = combo.get_active_id()
        if name:
            subprocess.run(["pactl", "set-default-sink", name], timeout=5)
            GLib.timeout_add(300, lambda: self.refresh() and False)

    def on_mixer(self, _b):
        self.hide()
        try:
            GLib.spawn_async(["pavucontrol"], flags=GLib.SpawnFlags.SEARCH_PATH)
        except GLib.Error:
            pass

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.hide()
        return False

    def follow_app_style(self):
        """This stays running between clicks: pick up a Classic/Modern
        (light/dark) switch made since it started."""
        try:
            iface = Gio.Settings.new("org.gnome.desktop.interface")
        except Exception:  # noqa: BLE001 - schema missing
            return
        st = Gtk.Settings.get_default()
        st.set_property("gtk-theme-name", iface.get_string("gtk-theme"))
        st.set_property("gtk-icon-theme-name", iface.get_string("icon-theme"))
        Gtk.IconTheme.get_default().set_custom_theme(iface.get_string("icon-theme"))
        st.set_property("gtk-application-prefer-dark-theme",
                        iface.get_string("color-scheme") == "prefer-dark")

    def open(self):
        self.follow_app_style()
        try:
            self.provider.load_from_path(theme_css())
        except GLib.Error as err:
            print(f"volume: {err.message}", file=sys.stderr)
        self.show_all()
        self.fill_devices()
        self.refresh()
        if self.timer is None:
            self.timer = GLib.timeout_add(1000, self.refresh)
        self.present()

    def do_hide(self):
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None
        Gtk.Window.do_hide(self)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.firox.Volume",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        cmd = args[0] if args else "toggle"
        if self.win is None:
            self.win = Popup(self)
        if cmd == "hide" or (cmd == "toggle" and self.win.get_visible()):
            self.win.hide()
        else:
            self.win.open()
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
