#!/usr/bin/python3
"""
firox-restore: System Restore. Go back to the version of Firox Linux you used
before an update.

    firox-restore

Firox Linux is an image-based system: each update installs a complete new
version next to the old one, and the previous version is kept. This lists
them (rpm-ostree status) and lets you:

  Restore            start the previous version from the next restart
                     (rpm-ostree rollback; asks for your password)
  Keep / Don't keep  keep a version even after later updates
                     (ostree admin pin)
  What changed…      the packages that differ from the version you're running
  Cancel the waiting update   (rpm-ostree cleanup --pending)
  Pause automatic updates     so a restored version isn't replaced the next
                     day (the rpm-ostreed-automatic timer)

Your files, settings and installed apps (Flatpaks) aren't affected. Older
versions you've kept can also be picked in the boot menu when the computer
starts.
"""

import json
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402

TIMER = "rpm-ostreed-automatic.timer"


def run(argv, timeout=60):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as err:
        return subprocess.CompletedProcess(argv, 1, "", str(err))


def deployments():
    r = run(["rpm-ostree", "status", "--json"])
    if r.returncode != 0:
        return None, (r.stderr or r.stdout).strip()
    try:
        return json.loads(r.stdout).get("deployments", []), ""
    except ValueError as err:
        return None, str(err)


def version(d):
    return d.get("version") or (d.get("checksum") or "")[:12]


def when(d):
    ts = d.get("timestamp")
    if not ts:
        return ""
    t = time.localtime(ts)
    return time.strftime("%A, %B ", t) + str(t.tm_mday) + time.strftime(", %Y", t)


def auto_updates_on():
    return run(["systemctl", "is-enabled", TIMER]).stdout.strip() == "enabled"


class Restore(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="System Restore")
        self.set_default_size(640, 620)
        self.set_icon_name("document-revert")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(14)
        self.add(box)

        head = Gtk.Box(spacing=12)
        icon = Gtk.Image.new_from_icon_name("document-revert", Gtk.IconSize.DIALOG)
        icon.set_valign(Gtk.Align.START)
        head.pack_start(icon, False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=60)
        intro.set_markup(
            "<span size='large'><b>Restore your computer to an earlier version</b></span>\n\n"
            "Each update installs a complete new version of Firox Linux and keeps the one you "
            "used before. If something stopped working after an update, go back to it here.\n\n"
            "Your files, settings and apps aren't affected.")
        head.pack_start(intro, True, True, 0)
        box.pack_start(head, False, False, 0)

        self.banner = Gtk.InfoBar()
        self.banner.set_no_show_all(True)
        self.banner_text = Gtk.Label(xalign=0, wrap=True)
        self.banner.get_content_area().add(self.banner_text)
        self.b_undo = self.banner.add_button("Undo", 2)
        self.b_undo.set_no_show_all(True)
        self.banner.add_button("Restart now", 1)
        self.banner.connect("response", self.on_banner)
        box.pack_start(self.banner, False, False, 0)

        self.list = Gtk.ListBox()
        self.list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.list.connect("row-selected", lambda *_: self.sync_buttons())
        sw = Gtk.ScrolledWindow()
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.set_min_content_height(200)
        sw.add(self.list)
        box.pack_start(sw, True, True, 0)

        row = Gtk.Box(spacing=6)
        self.b_restore = Gtk.Button.new_with_mnemonic("_Restore this version…")
        self.b_restore.connect("clicked", lambda _b: self.restore())
        self.b_keep = Gtk.Button.new_with_mnemonic("_Keep this version")
        self.b_keep.connect("clicked", lambda _b: self.keep())
        self.b_diff = Gtk.Button.new_with_mnemonic("_What changed…")
        self.b_diff.connect("clicked", lambda _b: self.what_changed())
        for b in (self.b_restore, self.b_keep, self.b_diff):
            row.pack_start(b, False, False, 0)
        box.pack_start(row, False, False, 0)

        self.hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
        self.hint.get_style_context().add_class("dim-label")
        box.pack_start(self.hint, False, False, 0)

        sep = Gtk.Separator()
        box.pack_start(sep, False, False, 4)
        upd = Gtk.Box(spacing=8)
        self.upd_label = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        upd.pack_start(self.upd_label, True, True, 0)
        self.b_cancel = Gtk.Button(label="Cancel the waiting update")
        self.b_cancel.set_valign(Gtk.Align.CENTER)
        self.b_cancel.set_no_show_all(True)
        self.b_cancel.connect("clicked", lambda _b: self.cancel_update())
        upd.pack_end(self.b_cancel, False, False, 0)
        self.b_pause = Gtk.Button()
        self.b_pause.set_valign(Gtk.Align.CENTER)
        self.b_pause.connect("clicked", lambda _b: self.toggle_updates())
        upd.pack_end(self.b_pause, False, False, 0)
        box.pack_start(upd, False, False, 0)

        self.deps = []
        self.reload()

    # ------------------------------------------------------------ state --
    def reload(self):
        deps, err = deployments()
        for child in self.list.get_children():
            child.destroy()
        if deps is None:
            self.list.add(Gtk.Label(label=f"Couldn't read the installed versions.\n{err}", margin=20))
            self.list.show_all()
            self.deps = []
            self.sync_buttons()
            return
        self.deps = deps
        installed = [d for d in deps if not d.get("staged")]
        booted = next((d for d in deps if d.get("booted")), None)
        default = installed[0] if installed else None
        staged = next((d for d in deps if d.get("staged")), None)
        # what `rpm-ostree rollback` would switch to
        if booted is not None and booted is default:
            self.target = installed[1] if len(installed) > 1 else None
        else:
            self.target = booted
        self.booted, self.default, self.staged = booted, default, staged

        for d in deps:
            tags = []
            if d.get("booted"):
                tags.append(("Running now", "running"))
            if d.get("staged") or (d is default and not d.get("booted")):
                tags.append(("Starts after you restart", "next"))
            elif d is self.target and d is not booted:
                tags.append(("Previous version", "previous"))
            if d.get("pinned"):
                tags.append(("Kept", "kept"))
            self.list.add(self.make_row(d, tags))
        self.list.show_all()
        first = self.list.get_row_at_index(next((i for i, d in enumerate(deps) if d is self.target),
                                               0) if deps else 0)
        if first is not None:
            self.list.select_row(first)

        if booted is not None and default is not None and default is not booted and not staged:
            self.banner_text.set_markup(
                f"Firox Linux <b>{GLib.markup_escape_text(version(default))}</b> will start the next "
                "time you restart.")
            self.banner.set_message_type(Gtk.MessageType.INFO)
            self.banner.show()
            self.banner_text.show()
            self.b_undo.show()
        elif staged is not None:
            self.banner_text.set_markup(
                f"An update, Firox Linux <b>{GLib.markup_escape_text(version(staged))}</b>, is waiting "
                "and will be installed the next time you restart.")
            self.banner.set_message_type(Gtk.MessageType.INFO)
            self.banner.show()
            self.banner_text.show()
        else:
            self.banner.hide()
        if not (booted is not None and default is not None and default is not booted and not staged):
            self.b_undo.hide()

        on = auto_updates_on()
        self.upd_label.set_markup(
            "<b>Automatic updates are on.</b> New versions download in the background." if on else
            "<b>Automatic updates are paused.</b> A restored version stays until you resume them.")
        self.b_pause.set_label("_Pause automatic updates" if on else "Res_ume automatic updates")
        self.b_pause.set_use_underline(True)
        self.b_cancel.set_visible(staged is not None)
        self.sync_buttons()

    def make_row(self, d, tags):
        row = Gtk.ListBoxRow()
        row.firox_dep = d
        box = Gtk.Box(spacing=10)
        box.set_border_width(8)
        icon = Gtk.Image.new_from_icon_name(
            "emblem-default" if d.get("booted") else
            "software-update-available" if d.get("staged") else "document-open-recent",
            Gtk.IconSize.DND)
        box.pack_start(icon, False, False, 0)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<b>Firox Linux {GLib.markup_escape_text(version(d))}</b>")
        texts.pack_start(title, False, False, 0)
        sub = Gtk.Label(label=when(d) or "", xalign=0)
        sub.get_style_context().add_class("dim-label")
        texts.pack_start(sub, False, False, 0)
        box.pack_start(texts, True, True, 0)
        for text, _kind in tags:
            lab = Gtk.Label()
            lab.set_markup(f"<small><b>{GLib.markup_escape_text(text)}</b></small>")
            box.pack_end(lab, False, False, 4)
        row.add(box)
        return row

    def selected(self):
        row = self.list.get_selected_row()
        return getattr(row, "firox_dep", None) if row else None

    def sync_buttons(self):
        d = self.selected()
        can_restore = d is not None and d is self.target and not d.get("booted") and not d.get("staged")
        self.b_restore.set_sensitive(can_restore)
        self.b_keep.set_sensitive(d is not None and not d.get("staged"))
        self.b_keep.set_label("Don't _keep this version" if d and d.get("pinned") else "_Keep this version")
        self.b_keep.set_use_underline(True)
        self.b_diff.set_sensitive(d is not None and self.booted is not None and d is not self.booted)
        if d is None:
            hint = ""
        elif d.get("booted"):
            hint = "This is the version you're using now."
        elif d.get("staged"):
            hint = "This update is installed when you restart. Cancel it below if you'd rather not."
        elif can_restore:
            hint = "Restore it, and it starts the next time you restart. You can undo that here."
        else:
            hint = ("To use this version, choose it in the boot menu when the computer starts "
                    "(hold Shift, or press Esc, while it starts).")
        self.hint.set_text(hint)

    # ---------------------------------------------------------- actions --
    def busy(self, text, argv, done):
        """Run argv with a small progress dialog; done(ok, output)."""
        dlg = Gtk.Dialog(title="System Restore", transient_for=self, modal=True)
        dlg.set_deletable(False)
        box = dlg.get_content_area()
        box.set_border_width(16)
        row = Gtk.Box(spacing=12)
        spinner = Gtk.Spinner()
        spinner.start()
        row.pack_start(spinner, False, False, 0)
        row.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
        box.pack_start(row, False, False, 0)
        dlg.show_all()
        try:
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as err:
            dlg.destroy()
            done(False, err.message)
            return

        def finished(p, res):
            try:
                _ok, out, _err = p.communicate_utf8_finish(res)
            except GLib.Error as err:
                out = err.message
            dlg.destroy()
            done(p.get_successful(), (out or "").strip())
        proc.communicate_utf8_async(None, None, finished)

    def report(self, ok, out, success_text=None):
        if ok:
            self.reload()
            if success_text:
                self.message(Gtk.MessageType.INFO, success_text, "")
            return
        # Cancelled at the password prompt: nothing to report
        if "dismissed" in out.lower() or "not authorized" in out.lower() or "126" in out:
            self.reload()
            return
        self.message(Gtk.MessageType.ERROR, "That didn't work", out[-1500:] or "Unknown error")
        self.reload()

    def message(self, kind, text, secondary):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                buttons=Gtk.ButtonsType.OK, text=text)
        if secondary:
            dlg.format_secondary_text(secondary)
        dlg.run()
        dlg.destroy()

    def confirm(self, text, secondary, ok_label):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=text)
        dlg.format_secondary_text(secondary)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button(ok_label, Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        return ok

    def restore(self):
        d = self.selected()
        if d is None or d is not self.target:
            return
        extra = ""
        if self.staged is not None:
            extra = f" The waiting update ({version(self.staged)}) will be cancelled."
        if auto_updates_on():
            extra += (" Automatic updates will download the newest version again later; pause them "
                      "below to stay on this one.")
        if not self.confirm(f"Restore Firox Linux {version(d)}?",
                            "It will start the next time you restart the computer. Your files, "
                            "settings and apps stay as they are." + extra, "Restore"):
            return
        argv = ["rpm-ostree", "rollback"]
        if self.staged is not None:
            argv = ["sh", "-c", "rpm-ostree cleanup --pending && rpm-ostree rollback"]
        self.busy("Restoring…", argv, lambda ok, out: self.after_restore(ok, out, d))

    def after_restore(self, ok, out, d):
        self.report(ok, out)
        if ok and self.confirm(f"Firox Linux {version(d)} will start after a restart",
                               "Restart now to start using it, or carry on and it'll be used the "
                               "next time you restart.", "Restart now"):
            self.restart()

    def keep(self):
        d = self.selected()
        if d is None or d.get("staged"):
            return
        index = self.deps.index(d)
        pinned = d.get("pinned")
        argv = ["pkexec", "ostree", "admin", "pin"] + (["--unpin"] if pinned else []) + [str(index)]
        self.busy("Saving…", argv, lambda ok, out: self.report(ok, out))

    def what_changed(self):
        d = self.selected()
        if d is None or self.booted is None:
            return
        old, new = (d, self.booted) if self.deps.index(d) > self.deps.index(self.booted) else (self.booted, d)
        r = run(["rpm-ostree", "db", "diff", old.get("checksum", ""), new.get("checksum", "")], timeout=120)
        text = (r.stdout or r.stderr).strip() or "The list of changed packages isn't available."
        dlg = Gtk.Dialog(title=f"Changes from {version(old)} to {version(new)}", transient_for=self, modal=True)
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        dlg.set_default_size(560, 440)
        view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                            left_margin=8, top_margin=6, bottom_margin=6)
        view.get_buffer().set_text(text)
        sw = Gtk.ScrolledWindow(vexpand=True)
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.add(view)
        area = dlg.get_content_area()
        area.set_border_width(10)
        area.pack_start(sw, True, True, 0)
        dlg.show_all()
        dlg.run()
        dlg.destroy()

    def cancel_update(self):
        if self.staged is None:
            return
        if not self.confirm(f"Cancel the update to {version(self.staged)}?",
                            "It won't be installed at the next restart. Automatic updates may "
                            "download it again later.", "Cancel the update"):
            return
        self.busy("Cancelling the update…", ["rpm-ostree", "cleanup", "--pending"],
                  lambda ok, out: self.report(ok, out))

    def toggle_updates(self):
        on = auto_updates_on()
        argv = ["pkexec", "systemctl", "disable" if on else "enable", "--now", TIMER]
        self.busy("Saving…", argv, lambda ok, out: self.report(ok, out))

    def on_banner(self, _bar, response):
        if response == 1:
            self.restart()
        elif response == 2:
            # rpm-ostree rollback again: the version you're running stays
            self.busy("Undoing…", ["rpm-ostree", "rollback"], lambda ok, out: self.report(ok, out))

    @staticmethod
    def restart():
        try:
            GLib.spawn_async(["firox-startmenu", "--power"], flags=GLib.SpawnFlags.SEARCH_PATH)
        except GLib.Error:
            pass


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.firox.Restore", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None

    def do_activate(self):
        if self.win is None:
            self.win = Restore(self)
            self.win.show_all()
        self.win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
