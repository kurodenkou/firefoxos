#!/usr/bin/python3
"""
firox-display-save: remember the current monitor layout.

Reads the live output configuration from the compositor (`wlr-randr --json`)
and stores it as a kanshi profile, keyed by the set of connected monitors.
kanshi (started from the session autostart) re-applies the matching profile
at every login and whenever monitors are plugged in or removed, so a laptop
alone and the same laptop on a dock each keep their own layout.

    firox-display-save            save the current layout
    firox-display-save --quiet    no notification

Firox owns ~/.config/kanshi/config only while it starts with the
"managed by Firox" header. If you write your own kanshi config, Firox leaves
it alone.
"""

import json
import os
import subprocess
import sys

CFG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
STORE = os.path.join(CFG, "firox", "displays.json")
KANSHI = os.path.join(CFG, "kanshi", "config")
HEADER = "# managed by Firox Linux (firox-display-save) - edits here are overwritten.\n" \
         "# Remove this header line to manage this file yourself.\n"


def notify(title, body=""):
    if "--quiet" in sys.argv:
        return
    subprocess.run(["notify-send", "-a", "Firox", "-i", "preferences-desktop-display", title, body],
                   check=False, stderr=subprocess.DEVNULL)


def current_outputs():
    out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def output_line(o):
    name = o["name"]
    if not o.get("enabled"):
        return f"    output {name} disable"
    parts = [f"    output {name} enable"]
    modes = o.get("modes", [])
    mode = next((m for m in modes if m.get("current")), None)
    if mode:
        # Real monitors advertise their modes (one marked preferred, from
        # EDID). Virtual/headless outputs don't, so kanshi must be told the
        # mode is custom or it refuses it.
        custom = "" if any(m.get("preferred") for m in modes) else "--custom "
        parts.append(f"mode {custom}{mode['width']}x{mode['height']}@{mode['refresh']:.3f}Hz")
    pos = o.get("position") or {}
    parts.append(f"position {pos.get('x', 0)},{pos.get('y', 0)}")
    if o.get("scale"):
        parts.append(f"scale {o['scale']:g}")
    if o.get("transform"):
        parts.append(f"transform {o['transform']}")
    if "adaptive_sync" in o:
        parts.append(f"adaptive_sync {'on' if o['adaptive_sync'] else 'off'}")
    return " ".join(parts)


def main():
    if os.path.exists(KANSHI):
        with open(KANSHI) as fh:
            if not fh.read().startswith(HEADER.splitlines()[0]):
                notify("Display layout not saved",
                       "You have your own ~/.config/kanshi/config, so Firox left it alone.")
                return 1

    try:
        outputs = current_outputs()
    except (OSError, subprocess.CalledProcessError, ValueError) as err:
        notify("Display layout not saved", f"Couldn't read the current layout: {err}")
        return 1
    if not outputs:
        return 1

    key = ",".join(sorted(o["name"] for o in outputs))
    profiles = {}
    try:
        with open(STORE) as fh:
            profiles = json.load(fh)
    except (OSError, ValueError):
        pass
    profiles[key] = [output_line(o) for o in sorted(outputs, key=lambda o: o["name"])]

    os.makedirs(os.path.dirname(STORE), exist_ok=True)
    with open(STORE + ".tmp", "w") as fh:
        json.dump(profiles, fh, indent=1)
    os.replace(STORE + ".tmp", STORE)

    text = HEADER
    for i, (k, lines) in enumerate(sorted(profiles.items())):
        text += f"\n# monitors: {k}\nprofile firox{i} {{\n" + "\n".join(lines) + "\n}\n"
    os.makedirs(os.path.dirname(KANSHI), exist_ok=True)
    with open(KANSHI + ".tmp", "w") as fh:
        fh.write(text)
    os.replace(KANSHI + ".tmp", KANSHI)

    # Let a running kanshi pick up the new file; kanshi exits at login when
    # there's no config yet, so start it if this is the first save.
    reloaded = subprocess.run(["kanshictl", "reload"], check=False,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not reloaded:
        subprocess.Popen(["kanshi"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    notify("Display settings saved", "Your screen layout will be restored at every login.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
